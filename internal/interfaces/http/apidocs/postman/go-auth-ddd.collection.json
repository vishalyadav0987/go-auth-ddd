                  "raw": "{{baseURL}}/api/v1/auth/login-with-password",
                  "host": [
                    "{{baseURL}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "login-with-password"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                      "",
                      "let body = {};",
                      "try { body = pm.response.json(); } catch (e) { /* non-JSON response */ }",
                      "const save = (key, value) => {",
                      "  if (value === undefined || value === null || value === \"\") return;",
                      "  pm.environment.set(key, String(value));",
                      "  console.log(`Saved ${key} to environment`);",
                      "};",
                      "save(\"otpAccessToken\", body?.data?.otpAccessToken);",
                      "save(\"userId\", body?.data?.userData?.id);"
                    ]
                  }
                }
              ]
            },
