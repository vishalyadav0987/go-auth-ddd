              "path": [
                "api",
                "v1",
                "payment",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"{{orderId}}\",\n  \"customer_phone\": \"{{userMobile}}\",\n  \"customer_email\": \"{{userEmail}}\",\n  \"return_url\": \"\",\n  \"notify_url\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh Idempotency-Key per send. To test idempotent replay,",
                  "// comment out the line below and re-send with the same key.",
                  "pm.environment.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
