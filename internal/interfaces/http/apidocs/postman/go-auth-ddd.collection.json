    {
      "name": "02 - Orders & Payments",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/api/v1/order/create",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scheme_code\": \"INF200K01RJ1\",\n  \"amount_paise\": 50000,\n  \"investment_type\": \"LUMPSUM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh Idempotency-Key per send. To test idempotent replay,",
                  "// comment out the line below and re-send with the same key.",
                  "pm.environment.set(\"idempotencyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) { /* non-JSON response */ }",
                  "const save = (key, value) => {",
                  "  if (value === undefined || value === null || value === \"\") return;",
                  "  pm.environment.set(key, String(value));",
                  "  console.log(`Saved ${key} to environment`);",
                  "};",
                  "save(\"orderId\", body?.order_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/api/v1/payment/create",
              "host": [
