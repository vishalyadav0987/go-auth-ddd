                  "",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) { /* non-JSON response */ }",
                  "const save = (key, value) => {",
                  "  if (value === undefined || value === null || value === \"\") return;",
                  "  pm.environment.set(key, String(value));",
                  "  console.log(`Saved ${key} to environment`);",
                  "};",
                  "save(\"paymentId\", body?.payment_id);",
                  "save(\"paymentSessionId\", body?.payment_session_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Payment Webhook (Cashfree)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-webhook-signature",
                "value": "{{webhookSignature}}"
              },
              {
                "key": "x-webhook-timestamp",
                "value": "{{webhookTimestamp}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/api/v1/payments/webhook",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "webhook"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"PAYMENT_SUCCESS_WEBHOOK\",\n  \"data\": {\n    \"order\": {\n      \"order_id\": \"{{orderId}}\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Requires a valid Cashfree signature; expect 401 without one.",
                  "pm.test(\"Responds\", () => pm.expect(pm.response.code).to.be.above(0));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{accessToken}}",
            "type": "string"
          }
        ]
      }
